# Exemple de fichier .env (NE PAS COMMITTER de vraies valeurs)
# Copiez ce fichier en .env et remplissez les valeurs sensibles sur la machine cible.

# URL de connexion à la base de données utilisée par Prisma
# Exemple (développement SQLite local) :
DATABASE_URL="file:./dev.db"
# Exemple (Postgres) :
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Clé utilisée pour le chiffrement local (doit faire 32 octets pour AES-256 dans ce projet)
# Remplacez par une chaîne aléatoire et secrète en production
ENCRYPTION_KEY="odsm-replace-with-a-secure-32-char-key"

# Environnement d'exécution (development|production)
NODE_ENV=development

# NOTE:
# - Ne mettez jamais de clés secrètes ni de mots de passe réels dans un dépôt Git.
# - Pour la production, utilisez le gestionnaire de secrets de votre plateforme (ex: GitHub Secrets, AWS Secrets Manager, Vault, Vercel envs, etc.).
# - Si vous utilisez des services externes (Stripe, Firebase, OpenAI...), ajoutez leurs clés ici (mais ne commitez pas) :
#   STRIPE_SECRET_KEY="sk_..."
#   OPENAI_API_KEY="sk-..."
#   GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/google-services.json
